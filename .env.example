# dqt local secrets 

# Anthropic Claude API
ANTHROPIC_API_KEY=<your-anthropic-api-key-here>

# JWT signing key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=<your-jwt-secret-key-here>

# Operational Postgres database
DATABASE_URL=<your-full-database-url-here>

GOOGLE_CLIENT_ID=<your-google-client-id-here>
GOOGLE_CLIENT_SECRET=<your-google-client-secret-here>
GOOGLE_REDIRECT_URI=<your-google-redirect-uri-here>

FRONTEND_URL=<your-frontend-url-here>
NEXT_PUBLIC_API_URL=<your-api-url-here> 
BACKEND_URL=<your-backend-url-here>
