# dqt secrets — copy to .env and fill in actual values.
# NEVER commit .env. This file (.env.example) is safe to commit.

# Warehouse credential encryption key
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DQT_CREDS_KEY=

# JWT signing key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Anthropic API key (for AI agent)
ANTHROPIC_API_KEY=
