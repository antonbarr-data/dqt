# dqt local development environment.
# Git-tracked. No secrets here — secrets go in .env.

# App
DQT_ENV=development

# Database (dqt metadata DB — not the monitored warehouse)
DATABASE_URL=postgresql+asyncpg://dqt:dqtdev@localhost:5434/dqt

# Redis
REDIS_URL=redis://localhost:6379

# Auth (non-secret settings; key goes in .env)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email (MailHog catches everything in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
EMAIL_FROM=dqt@localhost

# CORS
DQT_CORS_ORIGINS=http://localhost:3000

# Logging
DQT_LOG_LEVEL=INFO

# Frontend (consumed by Next.js as NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:8000
